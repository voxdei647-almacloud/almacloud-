# =========================================================
# ALMA CLOUD - variables de entorno para desarrollo local
# Copiar este archivo a .env y reemplazar los CAMBIAR_ESTO_xxx.
#
# Generar secretos locales:
#   openssl rand -hex 32
#
# No commitear .env.
# =========================================================

# Nombre de proyecto Compose. Cambiar si se levantan varias copias del repo.
COMPOSE_PROJECT_NAME=alma-cloud-dev

# Imágenes provisionales. No usar latest.
# Ver VERSIONES.md para digests y estado de tags.
POSTGRES_IMAGE=postgres:16-bookworm@sha256:0ea6700a3b4f0ae6ce746519073558aed4d88a79d8d07622a9a644946c7319c4
VALKEY_IMAGE=valkey/valkey:8-bookworm@sha256:fea8b3e67b15729d4bb70589eb03367bab9ad1ee89c876f54327fc7c6e618571
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.19.6@sha256:e321cb03c643874c42240458a618db56bc1e4fc143b10c41bec653542bc6851b

# Puertos publicados solo en 127.0.0.1
POSTGRES_PORT=5432
VALKEY_PORT=6379
OPENSEARCH_PORT=9200

# PostgreSQL
# POSTGRES_USER es superusuario y dueño de la base.
# NO debe usarse como rol de aplicación. Ver README.
POSTGRES_USER=alma_dev
POSTGRES_DB=alma_cloud
POSTGRES_PASSWORD=CAMBIAR_ESTO_postgres_password

# Valkey
# La contraseña se guarda en secrets/valkey_password y secrets/valkey_auth.conf.
# NO se lee de esta variable para arrancar el servicio.
VALKEY_MAXMEMORY=256mb

# OpenSearch
OPENSEARCH_HEAP=512m
# ---------------------------------------------------------------
# Bootstrap del primer super_admin (ejecutar una vez, ver README)
# ---------------------------------------------------------------
# Generar password con: openssl rand -hex 24
# IMPORTANTE: nunca commitear el .env con valores reales.
BOOTSTRAP_ADMIN_EMAIL=CAMBIAR_ESTO_admin@tu-dominio.local
BOOTSTRAP_ADMIN_PASSWORD=CAMBIAR_ESTO_generar_con_openssl
BOOTSTRAP_TENANT_ID=00000000-0000-0000-0000-000000000000
BOOTSTRAP_TENANT_NAME=Plataforma ALMA System
BOOTSTRAP_TENANT_SLUG=alma-platform
